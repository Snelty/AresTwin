  HEADER_TYPE             = "ENVI" 
  INTERCHANGE_FORMAT      = "ASCII" 
  BYTES                   = 1789
  DESCRIPTION             = "This text file can be used by ENVI image 
      processing software to read in the image."
END_OBJECT                = ENVI_HEADER


